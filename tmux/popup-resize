#!/bin/sh
# Re-fit the Alt+1..3 popups after the terminal window is resized. tmux sizes
# a popup once, as it opens (later it only shrinks one that no longer fits),
# so a popup opened in a small window stays small. These popups only attach
# to a session, so closing one and attaching again in a popup of the new
# size loses nothing.
#
# Opening one records "<host client> <width> <height> <host size> [popup
# args]" in @popup-<session> (see .tmux.conf, and ~/.ssh/bin/sshpick for
# the ssh picker, which passes its border style); a client attached to that
# session is the open popup. The client-resized hook runs this with no arguments: while a
# popup is open, its #{client_name} names the popup's client, not the host.

# One at a time: each hook run sees the record the previous one updated
exec 9>"${TMPDIR:-/tmp}/tmux-popup-resize.$(id -u).lock"
flock 9

# From list-clients: `display -c` would report the client of the session the
# hook ran in, which is the popup's
size() {
	tmux list-clients -F '#{client_name} #{client_width}x#{client_height}' |
		awk -v c="$1" '$1 == c { print $2 }'
}

for session in $(tmux list-clients -F '#{session_name}' | sort -u); do
	record=$(tmux show-options -gqv "@popup-$session")
	[ -n "$record" ] || continue
	# shellcheck disable=SC2086 # split the record into its fields
	set -- $record
	host=$1 w=$2 h=$3 was=$4 now=$(size "$1")
	shift 4
	[ -n "$now" ] && [ "$now" != "$was" ] || continue
	# A drag resizes many times over; wait for it to settle
	sleep 0.3
	[ "$(size "$host")" = "$now" ] || continue
	tmux set-option -g "@popup-$session" "$host $w $h $now $*"
	tmux display-popup -C -c "$host"
	# display-popup waits for the popup to close, so leave it running
	tmux display-popup -c "$host" -xC -yC -w "$w" -h "$h" "$@" \
		-E "tmux attach-session -t '$session'" >/dev/null 2>&1 9>&- &
done
