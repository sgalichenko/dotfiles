#!/usr/bin/env bash
set -euo pipefail

# Colors
BLUE='\033[1;34m'; YELLOW='\033[1;33m'; PURPLE='\033[1;35m'; NC="\033[0m"

# Help
if [[ $# -ne 2 ]]; then
  echo -e "\n${YELLOW}Please specify an action and a host.${NC}\n"
  echo -e "${BLUE}Available options:${NC}"
  echo -e "${PURPLE}$0 yank <host>${NC}  – copy ssh command to clipboard"
  echo -e "${PURPLE}$0 edit <host>${NC}  – edit host config\n"
  exit 0
fi

action="$1"
target="$2"
editor="nvim"
main="$HOME/.ssh/config"
configs=("$main")
while IFS= read -r inc; do
  for f in $inc; do configs+=("$f"); done
done < <(awk '/^Include / {print $2}' "$main")

# Find the first config file declaring this exact host name, and the line it's on
host_line() {
  awk -v target="$2" '
    $1 == "Host" {
      for (i = 2; i <= NF; i++) if ($i == target) { print NR; exit }
    }' "$1"
}

for cfg in "${configs[@]}"; do
  [[ -r $cfg ]] || continue
  line=$(host_line "$cfg" "$target")
  if [[ -n $line ]]; then
    config="$cfg"
    break
  fi
done

[[ -z ${config:-} ]] && { echo "Host '$target' not found."; exit 1; }

# Read a key from the target Host block only, stopping at the next Host/Match.
get_val() {
  awk -v start="$line" -v key="$1" '
    NR < start                                   { next }
    NR > start && ($1 == "Host" || $1 == "Match") { exit }
    $1 == key                                    { print $2; exit }
  ' "$config"
}

if [[ $action == "edit" ]]; then
  "$editor" "+$line" "$config"
elif [[ $action == "yank" ]]; then
  ssh_cmd="ssh "
  id_file=$(get_val IdentityFile)
  pjump=$(get_val ProxyJump)
  port=$(get_val Port)
  user=$(get_val User)
  host=$(get_val Hostname)
  # No explicit Hostname means the Host name itself is the address
  [[ $host ]] || host="$target"

  [[ $id_file ]] && ssh_cmd+="-i $id_file "
  [[ $pjump ]]   && ssh_cmd+="-J $pjump "
  [[ $port ]]    && ssh_cmd+="-p $port "
  [[ $user ]]    && ssh_cmd+="$user@"
  [[ $host ]]    && ssh_cmd+="$host"

  echo -n "$ssh_cmd" | xsel -ib
fi
