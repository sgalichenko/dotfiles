#!/usr/bin/env bash
# Toggles the Dell U2723QX between its HDMI-1 (0x11) and USB-C (0x1b; ddcutil
# lists it as "Unrecognized value") inputs (Super+m in GNOME). Used from both
# laptops, one on each input.

set -o nounset

# Talk to the monitor's I2C bus directly: without --bus ddcutil probes every
# display first, the laptop panel included, which adds about a second.
# The connector differs per laptop (HDMI-A-1 here, a DP one over USB-C) and
# the bus number changes with replugging, so find the Dell by its EDID.
bus_args=()
for conn in /sys/class/drm/card*-*; do
  [[ -e $conn/ddc ]] && grep -qa U2723QX "$conn/edid" 2>/dev/null || continue
  bus=$(basename "$(readlink "$conn/ddc")")
  bus_args=(--bus "${bus#i2c-}")
done

# The i2c buses get renumbered when i915 re-creates them (resume, replug),
# and the connector's link can briefly name a bus with no monitor on it
# ("No monitor detected on bus /dev/i2c-5"). Fall back to letting ddcutil
# find the monitor itself, slower but not tied to a bus number.
ddc() { ddcutil "${bus_args[@]}" "$@" 2>&1 || ddcutil "$@" 2>&1; }

# GNOME runs this without a terminal, so report failures as a notification.
fail() {
  notify-send -i video-display "ddcswitch failed" "$1"
  exit 1
}

# Switch to whichever input isn't showing.
current=$(ddc --terse getvcp 60) || fail "$current"
case $current in
  *x11) target=0x1b ;;
  *x1b) target=0x11 ;;
  *) fail "Unexpected input: $current" ;;
esac

# --noverify: no read-back after the switch, when the monitor may already be
# busy changing input.
err=$(ddc --noverify setvcp 60 "$target") || fail "$err"
